----- control factories -------------------------------------------------------

local function makeLabel(parent, text, order, height, color, bold)
    return make("TextLabel", {
        Size = UDim2.new(1, 0, 0, height or 18),
        BackgroundTransparency = 1,
        Font = bold and FontBold or FontRegular,
        Text = text,
        TextColor3 = color or Theme.text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        LayoutOrder = order or 0,
    }, parent)
end

local function makeSection(parent, text, order)
    local holder = make("Frame", {
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = order or 0,
    }, parent)
    makeLabel(holder, text, 0, 26, Theme.dim, true)
    return holder
end

local function makeToggle(parent, options)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundTransparency = 1,
        LayoutOrder = options.order or 0,
    }, parent)

    makeLabel(row, options.text, 0, 30, Theme.text, false)

    local switch = make("Frame", {
        Size = UDim2.new(0, 38, 0, 20),
        Position = UDim2.new(1, -38, 0.5, -10),
        BackgroundColor3 = options.value and Theme.accent or Theme.panelAlt,
        BackgroundTransparency = 0,
        BorderSizePixel = 0,
    }, row)
    corner(switch, 10)
    stroke(switch, Theme.stroke, 1)

    local knob = make("Frame", {
        Size = UDim2.new(0, 14, 0, 14),
        Position = UDim2.new(0, 3, 0.5, -7),
        BackgroundColor3 = Color3.fromRGB(245, 246, 250),
        BorderSizePixel = 0,
    }, switch)
    corner(knob, 7)

    local button = make("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    local handle = { value = options.value, frame = row, set = nil }

    local function paint(value)
        handle.value = value
        local goal = value
            and UDim2.new(0, 21, 0.5, -7)
            or UDim2.new(0, 3, 0.5, -7)
        TweenService:Create(knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad), { Position = goal }):Play()
        TweenService:Create(switch, TweenInfo.new(0.14, Enum.EasingStyle.Quad), {
            BackgroundColor3 = value and Theme.accent or Theme.panelAlt,
        }):Play()
    end

    handle.set = function(value, silent)
        paint(value)
        if not silent and options.onChange then options.onChange(value) end
    end

    trackConnection(button.MouseButton1Click:Connect(function()
        handle.set(not handle.value)
    end))
    trackConnection(button.MouseEnter:Connect(function()
        TweenService:Create(switch, TweenInfo.new(0.12), {
            BackgroundColor3 = handle.value and Theme.accent or Color3.fromRGB(44, 48, 60),
        }):Play()
    end))
    trackConnection(button.MouseLeave:Connect(function()
        TweenService:Create(switch, TweenInfo.new(0.12), {
            BackgroundColor3 = handle.value and Theme.accent or Theme.panelAlt,
        }):Play()
    end))

    return handle
end

local function makeSlider(parent, options)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 44),
        BackgroundTransparency = 1,
        LayoutOrder = options.order or 0,
    }, parent)

    makeLabel(row, options.text, 0, 18, Theme.text, false)

    local valueLabel = make("TextLabel", {
        Size = UDim2.new(0.5, 0, 0, 18),
        Position = UDim2.new(0.5, 0, 0, 0),
        BackgroundTransparency = 1,
        Font = FontRegular,
        Text = "",
        TextColor3 = Theme.dim,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    }, row)

    local hit = make("TextButton", {
        Size = UDim2.new(1, 0, 0, 20),
        Position = UDim2.new(0, 0, 0, 22),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    local track = make("Frame", {
        Size = UDim2.new(1, 0, 0, 4),
        Position = UDim2.new(0, 0, 0.5, -2),
        BackgroundColor3 = Theme.panelAlt,
        BorderSizePixel = 0,
    }, hit)
    corner(track, 2)

    local fill = make("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.accent,
        BorderSizePixel = 0,
    }, track)
    corner(fill, 2)

    local thumb = make("Frame", {
        Size = UDim2.new(0, 12, 0, 12),
        Position = UDim2.new(0, -6, 0.5, -6),
        BackgroundColor3 = Color3.fromRGB(245, 246, 250),
        BorderSizePixel = 0,
    }, track)
    corner(thumb, 6)
    stroke(thumb, Theme.bg, 2)

    local handle = { value = options.value, frame = row, set = nil, get = nil }
    local format = options.format or function(value) return string.format("%.2f", value) end
    local step = options.step or 0

    local function quantize(value)
        value = clamp(value, options.min, options.max)
        if step > 0 then
            value = options.min + math.floor((value - options.min) / step + 0.5) * step
            value = clamp(value, options.min, options.max)
        end
        return value
    end

    local function paint(value)
        handle.value = value
        local ratio = 0
        if options.max > options.min then
            ratio = (value - options.min) / (options.max - options.min)
        end
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        thumb.Position = UDim2.new(ratio, -6, 0.5, -6)
        valueLabel.Text = format(value)
    end

    local function setFromX(absoluteX)
        local width = track.AbsoluteSize.X
        if width <= 0 then return end
        local ratio = clamp((absoluteX - track.AbsolutePosition.X) / width, 0, 1)
        local value = quantize(options.min + (options.max - options.min) * ratio)
        if value ~= handle.value then
            paint(value)
            if options.onChange then options.onChange(value) end
        end
    end

    handle.set = function(value, silent)
        paint(quantize(value))
        if not silent and options.onChange then options.onChange(handle.value) end
    end
    handle.get = function() return handle.value end

    trackConnection(hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
            local dragging = true
            local moveConnection, endConnection
            moveConnection = trackConnection(UserInputService.InputChanged:Connect(function(changed)
                if not dragging then return end
                if changed.UserInputType == Enum.UserInputType.MouseMovement
                    or changed.UserInputType == Enum.UserInputType.Touch then
                    setFromX(changed.Position.X)
                end
            end))
            endConnection = trackConnection(UserInputService.InputEnded:Connect(function(ended)
                if ended.UserInputType == Enum.UserInputType.MouseButton1
                    or ended.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                    pcall(function() moveConnection:Disconnect() end)
                    pcall(function() endConnection:Disconnect() end)
                end
            end))
        end
    end))

    paint(options.value)
    return handle
end


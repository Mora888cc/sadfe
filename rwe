local function buildSettingsTab(win, env)
    local tab = win.tabs.Settings
    local handles = {}

    makeSection(tab, "KEYBINDS", 1)

    handles.toggleKey = makeKeybind(tab, {
        text = "Toggle GUI",
        value = State.toggleKey,
        order = 2,
        onChange = function(name) State.toggleKey = name end,
    })

    handles.panicKey = makeKeybind(tab, {
        text = "Panic revert",
        value = State.panicKey,
        order = 3,
        onChange = function(name) State.panicKey = name end,
    })

    makeSection(tab, "INTERFACE", 4)

    handles.uiScale = makeSlider(tab, {
        text = "UI scale",
        min = 0.7, max = 1.4, step = 0.05,
        value = State.uiScale,
        order = 5,
        format = function(value) return string.format("%.2fx", value) end,
        onChange = function(value)
            State.uiScale = value
            if GUI.scale then GUI.scale.Scale = value end
        end,
    })

    makeSection(tab, "CONFIG", 6)

    local saveButton = makeButton(tab, {
        text = "Save config",
        order = 7,
        onClick = function()
            local ok = Persistence.save()
            win.showNotice(ok and "Config saved" or "Save failed", ok and "good" or "bad")
        end,
    })

    local loadButton = makeButton(tab, {
        text = "Load config",
        order = 8,
        onClick = function()
            local ok = Persistence.load()
            win.showNotice(ok and "Config loaded" or "No config found", ok and "good" or "warn")
            if ok and GUI.refresh then GUI.refresh() end
        end,
    })

    local resetButton = makeButton(tab, {
        text = "Reset to defaults",
        order = 9,
        danger = true,
        onClick = function()
            Persistence.reset()
            win.showNotice("Defaults restored", "warn")
            if GUI.refresh then GUI.refresh() end
        end,
    })

    if not env.canPersist then
        saveButton.frame.TextTransparency = 0.5
        loadButton.frame.TextTransparency = 0.5
        saveButton.frame.Active = false
        loadButton.frame.Active = false
        saveButton.frame.Selectable = false
        loadButton.frame.Selectable = false
        local note = makeLabel(tab, "Executor exposes no filesystem — config is memory-only this session.", 10, 32, Theme.warn, false)
        note.TextSize = 11
        note.TextWrapped = true
    end

    return handles
end

local function buildAboutTab(win)
    local tab = win.tabs.About
    makeLabel(tab, "Penablox movement controller", 1, 20, Theme.text, true)
    makeLabel(tab, "Layered locomotion: property authority, per-frame reassert, velocity constraint, bounded micro-step.", 2, 44, Theme.dim, false).TextWrapped = true
    makeLabel(tab, "Version 1.0.0", 3, 18, Theme.dim, false)
    makeLabel(tab, "Layer 4 (CFrame micro-step) is off by default and carries detection risk. Everything else is reversible from the panic key.", 4, 52, Theme.warn, false).TextWrapped = true
end

----- diagnostics loop --------------------------------------------------------

local function startDiagnostics(handles)
    task.spawn(function()
        while GUI.screen and GUI.screen.Parent do
            task.wait(DIAG_INTERVAL)
            local lines = handles and handles.diag
            if lines then
                local hum = Engine.humanoid
                lines.WalkSpeed.Text = hum and string.format("%.2f", hum.WalkSpeed) or "—"
                lines.Drift.Text = string.format("%.2f", Engine.drift)
                lines.Constraint.Text = Engine.constraint and (Engine.constraint.Enabled and "active" or "idle") or "none"
                local active = 0
                for _, flag in pairs(Engine.status) do
                    if flag == true then active += 1 end
                end
                lines.Layers.Text = string.format("%d/4", active)
                lines.Ramp.Text = string.format("%.2fs", State.rampTime)
                lines["Rubber-band"].Text = State.rbLocked and "locked" or string.format("%d/%d", Engine.rbHits, State.rbSensitivity)
            end
        end
    end)
end

----- build -------------------------------------------------------------------

function GUI.build(env)
    local win = buildWindow(env)
    local movementHandles = buildMovementTab(win)
    local advancedHandles = buildAdvancedTab(win)
    local settingsHandles = buildSettingsTab(win, env)
    buildAboutTab(win)

    GUI.handles = {
        movement = movementHandles,
        advanced = advancedHandles,
        settings = settingsHandles,
    }

    -- keybinds + panic
    trackConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

        if GUI.capture then
            local capture = GUI.capture
            GUI.capture = nil
            pcall(capture, input.KeyCode)
            return
        end

        local panic = Enum.KeyCode[State.panicKey]
        if panic and input.KeyCode == panic then
            Engine.panic()
            if movementHandles.master then movementHandles.master.set(false, true) end
            win.showNotice("PANIC — vanilla restored", "bad")
            return
        end

        if gameProcessed then return end
        local toggle = Enum.KeyCode[State.toggleKey]
        if toggle and input.KeyCode == toggle then
            win.setMinimized(not State.minimized)
        end
    end))

    startDiagnostics(advancedHandles)
    Engine.onNotice = win.showNotice

    GUI.refresh = function()
        local m = GUI.handles.movement
        local a = GUI.handles.advanced
        local s = GUI.handles.settings
        m.master.set(State.enabled, true)
        m.speed.set(State.multiplier, true)
        m.ramp.set(State.rampTime, true)
        m.jitter.set(State.jitter, true)
        m.jump.set(State.jumpPower, true)
        m.jumpToggle.set(State.jumpEnabled, true)
        local band = bandFor(State.multiplier)
        m.band.Text = band.name
        m.band.TextColor3 = band.color
        a.layer2.set(State.layer2, true)
        a.layer3.set(State.layer3, true)
        a.layer4.set(State.layer4, true)
        a.airControl.set(State.airControl, true)
        a.gravity.set(State.gravityScale, true)
        a.gravityToggle.set(State.gravityEnabled, true)
        a.rb.set(State.rbSensitivity, true)
        a.force.set(State.maxForce, true)
        s.toggleKey.set(State.toggleKey)
        s.panicKey.set(State.panicKey)
        s.uiScale.set(State.uiScale, true)
        if GUI.scale then GUI.scale.Scale = State.uiScale end
        Engine.apply()
    end

    return win
end

function GUI.destroy()
    for _, connection in ipairs(GUI.connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(GUI.connections)
    if GUI.screen then
        pcall(function() GUI.screen:Destroy() end)
        GUI.screen = nil
    end
end

--=============================================================================
-- SECTION 8 — PERSISTENCE
--=============================================================================

Persistence = {}

local function encodeString(value)
    local out = { '"' }
    for index = 1, #value do
        local byte = string.byte(value, index)
        local char = string.sub(value, index, index)
        if char == '"' then
            out[#out + 1] = '\\"'
        elseif char == "\\" then
            out[#out + 1] = "\\\\"
        elseif char == "\n" then
            out[#out + 1] = "\\n"
        elseif char == "\r" then
            out[#out + 1] = "\\r"
        elseif char == "\t" then
            out[#out + 1] = "\\t"
        elseif byte < 32 then
            out[#out + 1] = string.format("\\u%04x", byte)
        else
            out[#out + 1] = char
        end
    end
    out[#out + 1] = '"'
    return table.concat(out)
end

local function encodeValue(value)
    local kind = type(value)
    if kind == "nil" then
        return "null"
    elseif kind == "boolean" then
        return value and "true" or "false"
    elseif kind == "number" then
        if value ~= value or value == math.huge or value == -math.huge then
            return "0"
        end
        return string.format("%.14g", value)
    elseif kind == "string" then
        return encodeString(value)
    elseif kind == "table" then
        local isArray = #value > 0
        if isArray then
            local parts = {}
            for index = 1, #value do
                parts[index] = encodeValue(value[index])
            end
            return "[" .. table.concat(parts, ",") .. "]"
        end
        local parts = {}
        for key, item in pairs(value) do
            if type(key) == "string" or type(key) == "number" then
                parts[#parts + 1] = encodeString(tostring(key)) .. ":" .. encodeValue(item)
            end
        end
        return "{" .. table.concat(parts, ",") .. "}"
    end
    return "null"
end

local function decodeValue(text, position)
    local length = #text

    local function skip()
        while position <= length do
            local char = string.sub(text, position, position)
            if char == " " or char == "\n" or char == "\r" or char == "\t" then
                position += 1
            else
                break
            end
        end
    end

    local function parseValue()
        skip()
        if position > length then return nil end
        local char = string.sub(text, position, position)

        if char == "{" then
            position += 1
            local object = {}
            skip()
            if string.sub(text, position, position) == "}" then
                position += 1
                return object
            end
            while position <= length do
                skip()
                if string.sub(text, position, position) ~= '"' then return object end
                local key = parseValue()
                skip()
                if string.sub(text, position, position) == ":" then position += 1 end
                local value = parseValue()
                if key ~= nil then object[key] = value end
                skip()
                local nextChar = string.sub(text, position, position)
                if nextChar == "," then
                    position += 1
                elseif nextChar == "}" then
                    position += 1
                    return object
                else
                    return object
                end
            end
            return object
        elseif char == "[" then
            position += 1
            local array = {}
            skip()
            if string.sub(text, position, position) == "]" then
                position += 1
                return array
            end
            while position <= length do
                array[#array + 1] = parseValue()
                skip()
                local nextChar = string.sub(text, position, position)
                if nextChar == "," then
                    position += 1
                elseif nextChar == "]" then
                    position += 1
                    return array
                else
                    return array
                end
            end
            return array
        elseif char == '"' then
            position += 1
            local buffer = {}
            while position <= length do
                local current = string.sub(text, position, position)
                if current == "\\" then
                    local escaped = string.sub(text, position + 1, position + 1)
                    if escaped == "n" then
                        buffer[#buffer + 1] = "\n"
                    elseif escaped == "r" then
                        buffer[#buffer + 1] = "\r"
                    elseif escaped == "t" then
                        buffer[#buffer + 1] = "\t"
                    elseif escaped == "u" then
                        local hex = string.sub(text, position + 2, position + 5)
                        local code = tonumber(hex, 16) or 63
                        buffer[#buffer + 1] = string.char(math.min(code, 255))
                        position += 4
                    else
                        buffer[#buffer + 1] = escaped
                    end
                    position += 2
                elseif current == '"' then
                    position += 1
                    return table.concat(buffer)
                else
                    buffer[#buffer + 1] = current
                    position += 1
                end
            end
            return table.concat(buffer)
        elseif string.sub(text, position, position + 3) == "true" then
            position += 4
            return true
        elseif string.sub(text, position, position + 4) == "false" then
            position += 5
            return false
        elseif string.sub(text, position, position + 3) == "null" then
            position += 4
            return nil
        else
            local start = position
            while position <= length do
                local current = string.sub(text, position, position)
                if current == "," or current == "}" or current == "]" or current == " "
                    or current == "\n" or current == "\r" or current == "\t" then
                    break
                end
                position += 1
            end
            local number = tonumber(string.sub(text, start, position - 1))
            return number or 0
        end
    end

    return parseValue()
end

function Persistence.encode(value)
    return encodeValue(value)
end

function Persistence.decode(text)
    local ok, result = pcall(decodeValue, text, 1)
    if ok and type(result) == "table" then return result end
    return nil
end

local function configSnapshot()
    local snapshot = { version = CONFIG_VERSION }
    for key, value in pairs(DEFAULTS) do
        snapshot[key] = State[key]
    end
    return snapshot
end

function Persistence.save()
    if not ENV.canPersist then return false end
    local ok = pcall(function()
        if ENV.isfolder and not ENV.isfolder(CONFIG_FOLDER) then
            ENV.makefolder(CONFIG_FOLDER)
        end
    end)
    if not ok then
        log("warn", "persist", "folder creation failed — memory only")
        return false
    end

    local payload = Persistence.encode(configSnapshot())
    local wrote = pcall(function() ENV.writefile(CONFIG_PATH, payload) end)
    if not wrote then
        log("warn", "persist", "writefile failed — memory only")
        return false
    end

    -- self-check: read back and round-trip before accepting the write
    local verified = pcall(function()
        local raw = ENV.readfile(CONFIG_PATH)
        local parsed = Persistence.decode(raw)
        if not parsed then error("decode failed") end
        if parsed.version ~= CONFIG_VERSION then error("version mismatch") end
        return true
    end)
    if not verified then
        log("warn", "persist", "round-trip self-check failed — discarding write")
        pcall(function() ENV.delfile(CONFIG_PATH) end)
        return false
    end

    State.savedAt = os.time()
    State.loadedFromDisk = true
    log("info", "persist", "config saved and verified")
    return true
end

function Persistence.load()
    if not ENV.canPersist then return false end
    if ENV.isfile and not ENV.isfile(CONFIG_PATH) then return false end

    local ok, raw = pcall(function() return ENV.readfile(CONFIG_PATH) end)
    if not ok or type(raw) ~= "string" then return false end

    local parsed = Persistence.decode(raw)
    if not parsed then
        log("warn", "persist", "config decode failed")
        return false
    end

    for key, defaultValue in pairs(DEFAULTS) do
        local value = parsed[key]
        if value ~= nil and type(value) == type(defaultValue) then
            State[key] = value
        end
    end
    State.rbLocked = false
    State.loadedFromDisk = true
    log("info", "persist", "config loaded")
    return true
end

function Persistence.reset()
    for key, value in pairs(DEFAULTS) do
        State[key] = value
    end
    State.rbLocked = false
    Engine.apply()
end

--=============================================================================
-- SECTION 9 — BOOTSTRAP
--=============================================================================

ENV = buildEnv()

-- Re-execution guard: a previous instance is torn down before this one boots,
-- so two rapid pastes never leave two Heartbeat connections behind.
local registry = ENV.getgenv
local previous = nil
if registry then
    local ok, existing = pcall(function() return registry.__PBX_MOVEMENT end)
    if ok then previous = existing end
end

if previous and type(previous) == "table" and previous.destroy then
    pcall(previous.destroy)
end

local function boot()
    log("info", "boot", string.format(
        "executor=%s filesystem=%s gethui=%s",
        tostring(ENV.identify and select(2, pcall(ENV.identify)) or "unknown"),
        tostring(ENV.canPersist),
        tostring(ENV.gethui ~= nil)
    ))

    Persistence.load()

    local win = GUI.build(ENV)

    if not ENV.canPersist then
        log("info", "boot", "no filesystem — config is memory-only this session")
    end

    bindLifecycle()

    local character = LocalPlayer.Character
    if character then
        task.defer(function()
            if Engine.attach(character) then
                Engine.apply()
            end
        end)
    else
        log("info", "boot", "no character yet — waiting for CharacterAdded")
    end

    local api
    api = {
        version = CONFIG_VERSION,
        state = State,
        engine = Engine,
        gui = GUI,
        persistence = Persistence,
        destroy = function()
            Engine.detach()
            unbindLifecycle()
            GUI.destroy()
            if registry then
                pcall(function()
                    if registry.__PBX_MOVEMENT == api then registry.__PBX_MOVEMENT = nil end
                end)
            end
            log("info", "shutdown", "clean teardown complete")
        end,
    }

    if registry then
        registry.__PBX_MOVEMENT = api
    end

    log("info", "boot", "Penablox movement controller ready")
    return api
end

local ok, result = pcall(boot)
if not ok then
    log("error", "boot", "bootstrap failed: " .. tostring(result))
    pcall(function()
        local screen = Instance.new("ScreenGui")
        screen.Name = "PBXMovementError"
        screen.ResetOnSpawn = false
        screen.Parent = LocalPlayer:FindFirstChild("PlayerGui")
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0, 420, 0, 60)
        label.Position = UDim2.new(0, 20, 0, 20)
        label.BackgroundColor3 = Color3.fromRGB(30, 20, 20)
        label.TextColor3 = Color3.fromRGB(255, 140, 140)
        label.Font = Enum.Font.GothamMedium
        label.TextSize = 12
        label.TextWrapped = true
        label.Text = "Penablox movement failed to boot: " .. tostring(result)
        label.Parent = screen
    end)
end

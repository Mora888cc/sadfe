-- Records the pre-modification values. Every revert path reads this, never a
-- magic number.
function Engine.captureVanilla()
    local hum = Engine.humanoid
    if not hum then return end
    Engine.vanilla = {
        walkSpeed    = hum.WalkSpeed,
        jumpPower    = hum.JumpPower,
        jumpHeight   = hum.JumpHeight,
        useJumpPower = hum.UseJumpPower,
        hipHeight    = hum.HipHeight,
        gravity      = Workspace.Gravity,
    }
end

function Engine.destroyConstraint()
    if Engine.constraint then
        pcall(function() Engine.constraint.Enabled = false end)
        pcall(function() Engine.constraint:Destroy() end)
        Engine.constraint = nil
    end
    if Engine.attachment then
        pcall(function() Engine.attachment:Destroy() end)
        Engine.attachment = nil
    end
    Engine.status.layer3 = false
end

-- Restores every property from the snapshot. Safe to call twice.
function Engine.restoreVanilla()
    local snapshot = Engine.vanilla
    local hum = Engine.humanoid
    if not snapshot then return end
    if hum and hum.Parent then
        pcall(function()
            hum.WalkSpeed    = snapshot.walkSpeed
            hum.JumpPower    = snapshot.jumpPower
            hum.JumpHeight   = snapshot.jumpHeight
            hum.UseJumpPower = snapshot.useJumpPower
            hum.HipHeight    = snapshot.hipHeight
        end)
    end
    pcall(function() Workspace.Gravity = snapshot.gravity end)
    Engine.status.layer1 = false
    Engine.status.layer2 = false
    Engine.status.layer4 = false
end

function Engine.stopConnection()
    if Engine.connection then
        pcall(function() Engine.connection:Disconnect() end)
        Engine.connection = nil
    end
end

-- Full teardown. Order: producers, connections, constraints, properties, refs.
function Engine.detach()
    Engine.stopConnection()
    Engine.destroyConstraint()
    Engine.restoreVanilla()
    Engine.humanoid  = nil
    Engine.root      = nil
    Engine.character = nil
    Engine.dir       = nil
    Engine.speed     = 0
    Engine.target    = 0
    Engine.rampActive = false
    Engine.lastPos   = nil
    Engine.rbHits    = 0
    Engine.rbWindow  = 0
    Engine.reasserts = 0
    Engine.reassertBackoff = false
end

-- Panic path. One frame: disconnect, destroy constraint, restore vanilla.
function Engine.panic()
    State.enabled = false
    Engine.detach()
    if Engine.onNotice then Engine.onNotice("Panic revert applied", "bad") end
    log("warn", "panic", "panic key — all layers detached, vanilla restored")
end

-- Ensures exactly one constraint + attachment exist for the current root.
local function ensureConstraint()
    local root = Engine.root
    if not root or not root.Parent then
        Engine.destroyConstraint()
        return false
    end
    if Engine.constraint and Engine.constraint.Parent == root and Engine.attachment and Engine.attachment.Parent == root then
        return true
    end
    Engine.destroyConstraint()
    local ok = pcall(function()
        local attachment = Instance.new("Attachment")
        attachment.Name = "PBX_VelocityAttachment"
        attachment.Parent = root

        local velocity = Instance.new("LinearVelocity")
        velocity.Name = "PBX_VelocityConstraint"
        velocity.Attachment0 = attachment
        velocity.RelativeTo = Enum.ActuatorRelativeTo.World
        velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
        velocity.VectorVelocity = Vector3.zero
        velocity.MaxForce = State.maxForce
        velocity.Parent = root

        Engine.attachment = attachment
        Engine.constraint = velocity
    end)
    if not ok then
        Engine.destroyConstraint()
        log("error", "constraint", "LinearVelocity attach failed — Layer 3 unavailable")
        return false
    end
    return true
end

-- Desired horizontal direction. Humanoid.MoveDirection first (it already
-- accounts for seats and ladders); raw WASD projected on the camera basis as
-- the fallback, world axes when the camera is near-vertical (top-down).
local function readDirection()
    local hum = Engine.humanoid
    if not hum then return nil end

    local moveDirection = hum.MoveDirection
    if moveDirection.Magnitude > 0.05 then
        local flat = Vector3.new(moveDirection.X, 0, moveDirection.Z)
        if flat.Magnitude > 0.001 then return flat.Unit end
    end

    if not UserInputService.KeyboardEnabled then return nil end
    local x, z = 0, 0
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then z -= 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then z += 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then x -= 1 end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then x += 1 end
    if x == 0 and z == 0 then return nil end

    local camera = Workspace.CurrentCamera
    if camera then
        local look = camera.CFrame.LookVector
        local right = camera.CFrame.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatLook.Magnitude > 0.2 and flatRight.Magnitude > 0.2 then
            local dir = flatLook.Unit * (-z) + flatRight.Unit * x
            if dir.Magnitude > 0.01 then return dir.Unit end
        end
    end
    return Vector3.new(x, 0, z).Unit
end

-- Shaped acceleration curve. Recomputed on input onset only; the ramp restarts
-- on every fresh press so stop/start is not a plateau.
local function computeSpeed()
    local base = (Engine.vanilla and Engine.vanilla.walkSpeed) or DEFAULT_WALKSPEED
    local target = base * State.multiplier
    local rampTime = State.rampTime

    if rampTime > 0 and Engine.rampActive then
        local progress = (os.clock() - Engine.rampStart) / rampTime
        if progress < 1 then
            local eased = 1 - (1 - progress) * (1 - progress)
            target = target * eased
        end
    end

    if State.jitter > 0 then
        target = target * (1 + (math.random() * 2 - 1) * State.jitter)
    end
    return target
end

-- Rubber-band detector. A server correction shows up as a displacement jump the
-- character's own velocity cannot explain.
local function checkRubberBand(root, dt)
    local now = os.clock()
    if now - Engine.rbWindow > RB_WINDOW then
        Engine.rbWindow = now
        Engine.rbHits = 0
    end

    local position = root.Position
    if Engine.lastPos then
        local delta = (position - Engine.lastPos).Magnitude
        local expected = Engine.speed * dt * 2.5 + 2
        if delta > math.max(expected, RB_MIN_JUMP) then
            Engine.rbHits += 1
            if Engine.rbHits >= State.rbSensitivity and not Engine.rbLocked() then
                State.layer4 = false
                State.multiplier = math.min(State.multiplier, 2.0)
                State.rbLocked = true
                Engine.rbHits = 0
                log("warn", "rubberband", "server correction detected — aggressive layer off, dropped to Stealth")
                if Engine.onNotice then Engine.onNotice("Rubber-band detected — dropped to Stealth", "warn") end
                if GUI and GUI.refresh then GUI.refresh() end
            end
        end
    end
    Engine.lastPos = position
end

Engine.rbLocked = function() return State.rbLocked end

-- The single per-frame writer. Exactly one Heartbeat connection feeds this.
local function onHeartbeat(dt)
    local hum = Engine.humanoid
    local root = Engine.root
    if not hum or not root or not hum.Parent or not root.Parent then return end
    if hum.Health <= 0 then return end

    local dir = readDirection()
    Engine.dir = dir

    if dir then
        if not Engine.rampActive then
            Engine.rampActive = true
            Engine.rampStart = os.clock()
        end
    else
        Engine.rampActive = false
    end

    local speed = computeSpeed()
    Engine.target = (Engine.vanilla and Engine.vanilla.walkSpeed or DEFAULT_WALKSPEED) * State.multiplier
    Engine.speed = speed

    local grounded = hum.FloorMaterial ~= Enum.Material.Air

    -- LAYER 1 / 2 — property authority + per-frame reassert
    if State.enabled and State.layer1 then
        local targetWalk = speed
        if math.abs(hum.WalkSpeed - targetWalk) > REASSERT_EPSILON then
            Engine.drift = hum.WalkSpeed - targetWalk
            if State.layer2 then
                local now = os.clock()
                if now - Engine.reassertWindow > REASSERT_WINDOW then
                    Engine.reassertWindow = now
                    Engine.reasserts = 0
                    Engine.reassertBackoff = false
                end
                Engine.reasserts += 1
                if Engine.reasserts > REASSERT_BUDGET then
                    if not Engine.reassertBackoff then
                        Engine.reassertBackoff = true
                        log("warn", "reassert", "WalkSpeed clamp fight — backing off reassert for this window")
                    end
                else
                    pcall(function() hum.WalkSpeed = targetWalk end)
                    Engine.framesSinceReassert = 0
                    Engine.status.layer2 = true
                end
            else
                Engine.status.layer2 = false
            end
            Engine.status.layer1 = true
        else
            Engine.drift = 0
            Engine.framesSinceReassert += 1
        end
    else
        Engine.status.layer1 = false
        Engine.status.layer2 = false
    end

    -- LAYER 3 — velocity constraint
    if State.enabled and State.layer3 then
        if ensureConstraint() then
            local allowed = grounded or State.airControl
            if allowed and dir then
                local velocity = dir * speed
                pcall(function()
                    Engine.constraint.VectorVelocity = velocity
                    Engine.constraint.MaxForce = State.maxForce
                    Engine.constraint.Enabled = true
                end)
                Engine.status.layer3 = true
            else
                pcall(function()
                    Engine.constraint.VectorVelocity = Vector3.zero
                    Engine.constraint.Enabled = false
                end)
                Engine.status.layer3 = false
            end
        end
    else
        if Engine.constraint then
            pcall(function()
                Engine.constraint.VectorVelocity = Vector3.zero
                Engine.constraint.Enabled = false
            end)
        end
        Engine.status.layer3 = false
    end

    -- LAYER 4 — CFrame micro-step (bounded burst, enforced cooldown)
    if State.enabled and State.layer4 and not Engine.status.layer3 then
        local now = os.clock()
        if dir and now - Engine.microLast >= State.microStepCool then
            if Engine.microBurst <= 0 then
                Engine.microBurst = MICROSTEP_BURST
                Engine.microLast = now
                Engine.status.layer4 = false
            else
                Engine.microBurst -= 1
                pcall(function()
                    root.CFrame = root.CFrame + dir * State.microStepDist
                end)
                Engine.status.layer4 = true
            end
        end
    else
        Engine.status.layer4 = false
        Engine.microBurst = 0
    end

    -- Jump reassert
    if State.enabled and State.jumpEnabled then
        local snapshot = Engine.vanilla
        if snapshot then
            pcall(function()
                if hum.UseJumpPower then
                    if math.abs(hum.JumpPower - State.jumpPower) > 0.5 then
                        hum.JumpPower = State.jumpPower
                    end
                else
                    local targetHeight = State.jumpPower * 0.14
                    if math.abs(hum.JumpHeight - targetHeight) > 0.5 then
                        hum.JumpHeight = targetHeight
                    end
                end
            end)
        end
    end

    -- Gravity scale
    if State.enabled and State.gravityEnabled then
        local snapshot = Engine.vanilla
        if snapshot then
            local targetGravity = snapshot.gravity * State.gravityScale
            if math.abs(Workspace.Gravity - targetGravity) > 0.5 then
                pcall(function() Workspace.Gravity = targetGravity end)
            end
        end
    end

    checkRubberBand(root, dt)
end

function Engine.attach(character)
    Engine.detach()
    if not character then return false end

    local hum = character:FindFirstChildOfClass("Humanoid")
    local root = waitFor(character, "HumanoidRootPart", 5)
    if not hum or not root then
        log("warn", "attach", "character missing Humanoid or HumanoidRootPart")
        return false
    end

    Engine.character = character
    Engine.humanoid = hum
    Engine.root = root
    Engine.captureVanilla()
    Engine.lastPos = root.Position
    Engine.rampActive = false
    Engine.reassertWindow = os.clock()
    Engine.rbWindow = os.clock()
    Engine.reassertBackoff = false

    Engine.stopConnection()
    Engine.connection = RunService.Heartbeat:Connect(function(dt)
        local ok, err = pcall(onHeartbeat, dt)
        if not ok then
            log("error", "heartbeat", tostring(err))
        end
    end)

    log("info", "attach", "engine attached — vanilla WalkSpeed " .. tostring(Engine.vanilla.walkSpeed))
    return true
end

-- Re-push current State into the engine without a respawn.
function Engine.apply()
    if not Engine.humanoid then return end
    if not State.enabled then
        Engine.restoreVanilla()
        Engine.destroyConstraint()
        return
    end
    if State.layer3 then
        ensureConstraint()
    else
        Engine.destroyConstraint()
    end
    if not State.gravityEnabled then
        local snapshot = Engine.vanilla
        if snapshot then pcall(function() Workspace.Gravity = snapshot.gravity end) end
    end
    if not State.jumpEnabled then
        local snapshot = Engine.vanilla
        local hum = Engine.humanoid
        if snapshot and hum then
            pcall(function()
                hum.JumpPower = snapshot.jumpPower
                hum.JumpHeight = snapshot.jumpHeight
                hum.UseJumpPower = snapshot.useJumpPower
            end)
        end
    end
end

--=============================================================================
-- SECTION 6 — CHARACTER LIFECYCLE
--=============================================================================

local Lifecycle = { connections = {} }

local function bindLifecycle()
    local function connect(signal, handler)
        Lifecycle.connections[#Lifecycle.connections + 1] = signal:Connect(handler)
    end

    connect(LocalPlayer.CharacterAdded, function(character)
        task.defer(function()
            local hum = waitFor(character, "Humanoid", 5)
            if hum then
                hum.Died:Connect(function()
                    Engine.destroyConstraint()
                    Engine.status.layer3 = false
                end)
            end
            Engine.attach(character)
            Engine.apply()
        end)
    end)

    connect(LocalPlayer.CharacterRemoving, function()
        Engine.destroyConstraint()
        Engine.stopConnection()
        Engine.status.layer3 = false
    end)

    connect(Workspace:GetPropertyChangedSignal("CurrentCamera"), function()
        -- camera swaps do not touch the engine, but direction fallback needs a
        -- live camera; nothing to do beyond keeping the reference fresh
    end)
end

local function unbindLifecycle()
    for _, connection in ipairs(Lifecycle.connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(Lifecycle.connections)
end


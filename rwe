local function probe(fn)
    local ok, value = pcall(fn)
    if ok then return value end
    return nil
end

local function buildEnv()
    local env = {}
    env.getgenv        = probe(function() return getgenv() end)
    env.getrenv        = probe(function() return getrenv() end)
    env.gethui         = probe(function() return gethui() end)
    env.getreg         = probe(function() return getreg() end)
    env.identify       = probe(function() return identifyexecutor() end)
    env.loadstring     = probe(function() return loadstring end)
    env.request        = probe(function() return request end)
        or probe(function() return http_request end)
        or probe(function() return syn.request end)
        or probe(function() return fluxus.request end)
    env.writefile      = probe(function() return writefile end)
    env.readfile       = probe(function() return readfile end)
    env.appendfile     = probe(function() return appendfile end)
    env.isfile         = probe(function() return isfile end)
    env.isfolder       = probe(function() return isfolder end)
    env.makefolder     = probe(function() return makefolder end)
    env.listfiles      = probe(function() return listfiles end)
    env.delfile        = probe(function() return delfile end)
    env.hookfunction   = probe(function() return hookfunction end)
    env.hookmetamethod = probe(function() return hookmetamethod end)
    env.getrawmeta     = probe(function() return getrawmetatable end)
    env.setreadonly    = probe(function() return setreadonly end)
    env.getnamecall    = probe(function() return getnamecallmethod end)
    env.getconnections = probe(function() return getconnections end)
    env.firesignal     = probe(function() return firesignal end)
    env.cloneref       = probe(function() return cloneref end)
    env.setclipboard   = probe(function() return setclipboard end)
    env.getcustomasset = probe(function() return getcustomasset end)

    env.hasFilesystem = env.writefile ~= nil and env.readfile ~= nil
    env.canPersist    = env.hasFilesystem and env.makefolder ~= nil

    return env
end

--=============================================================================
-- SECTION 3 — UTILITIES
--=============================================================================

local function clamp(value, lo, hi)
    if value < lo then return lo end
    if value > hi then return hi end
    return value
end

local function lerp(a, b, t)
    return a + (b - a) * t
end

local function round(value, places)
    local mult = 10 ^ (places or 0)
    return math.floor(value * mult + 0.5) / mult
end

-- Bounded WaitForChild. Returns nil instead of yielding forever.
local function waitFor(parent, name, timeout)
    if not parent then return nil end
    local existing = parent:FindFirstChild(name)
    if existing then return existing end
    local ok, child = pcall(function()
        return parent:WaitForChild(name, timeout or 10)
    end)
    if ok then return child end
    return nil
end

local function bandFor(multiplier)
    for _, band in BANDS do
        if multiplier <= band.limit then return band end
    end
    return BANDS[#BANDS]
end

-- Throttled logger: one line per key per LOG_RATE seconds.
local logTimes = {}
local function log(level, key, message)
    local now = os.clock()
    local last = logTimes[key]
    if last and now - last < LOG_RATE then return end
    logTimes[key] = now
    print(string.format("[Penablox][%s] %s", level, message))
end


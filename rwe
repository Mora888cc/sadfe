    for index, name in ipairs(tabNames) do
        local button = make("TextButton", {
            Size = UDim2.new(0, 0, 1, 0),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundColor3 = Theme.panel,
            BorderSizePixel = 0,
            Font = FontRegular,
            Text = name,
            TextColor3 = Theme.dim,
            TextSize = 12,
            AutoButtonColor = false,
            LayoutOrder = index,
        }, tabBar)
        make("UIPadding", {
            PaddingLeft = UDim.new(0, 12),
            PaddingRight = UDim.new(0, 12),
        }, button)
        corner(button, 6)
        tabButtons[name] = button
        tabFrames[name] = makeTabContent(contentHolder, name)
    end

    -- pill (minimized state)
    local pill = make("TextButton", {
        Name = "Pill",
        Size = UDim2.new(0, 132, 0, 30),
        Position = UDim2.new(0.5, -66, 0.5, -15),
        BackgroundColor3 = Theme.panel,
        BorderSizePixel = 0,
        Font = FontBold,
        Text = "PENABLOX",
        TextColor3 = Theme.accent,
        TextSize = 11,
        AutoButtonColor = false,
        Visible = false,
    }, screen)
    corner(pill, 15)
    stroke(pill, Theme.stroke, 1)

    GUI.screen = screen
    GUI.frame = frame
    GUI.body = body
    GUI.pill = pill
    GUI.scale = scale
    GUI.tabs = tabFrames

    local function selectTab(name)
        GUI.activeTab = name
        for tabName, tabButton in pairs(tabButtons) do
            tabButton.BackgroundColor3 = (tabName == name) and Theme.panelAlt or Theme.panel
            tabButton.TextColor3 = (tabName == name) and Theme.text or Theme.dim
        end
        for tabName, content in pairs(tabFrames) do
            content.Visible = (tabName == name)
        end
    end

    for name, button in pairs(tabButtons) do
        trackConnection(button.MouseButton1Click:Connect(function() selectTab(name) end))
    end

    -- drag
    local dragging = false
    local dragOffset = Vector2.zero
    trackConnection(header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragOffset = Vector2.new(input.Position.X - frame.AbsolutePosition.X,
                                     input.Position.Y - frame.AbsolutePosition.Y)
        end
    end))
    trackConnection(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    trackConnection(UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
        local size = frame.AbsoluteSize
        local x = clamp(input.Position.X - dragOffset.X, 0, math.max(0, viewport.X - size.X))
        local y = clamp(input.Position.Y - dragOffset.Y, 0, math.max(0, viewport.Y - size.Y))
        frame.Position = UDim2.fromOffset(x, y)
    end))

    -- minimize / restore
    local minimized = State.minimized
    local function setMinimized(value)
        minimized = value
        State.minimized = value
        frame.Visible = not value
        pill.Visible = value
    end

    trackConnection(minimize.MouseButton1Click:Connect(function() setMinimized(true) end))
    trackConnection(pill.MouseButton1Click:Connect(function() setMinimized(false) end))
    trackConnection(close.MouseButton1Click:Connect(function() setMinimized(true) end))
    setMinimized(minimized)

    -- toast
    local notice = make("TextLabel", {
        Size = UDim2.new(1, -28, 0, 26),
        Position = UDim2.new(0, 14, 1, -36),
        BackgroundColor3 = Theme.panelAlt,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Font = FontRegular,
        Text = "",
        TextColor3 = Theme.text,
        TextSize = 12,
        Visible = false,
    }, body)
    corner(notice, 6)

    local noticeToken = 0
    local function showNotice(text, kind)
        noticeToken += 1
        local token = noticeToken
        notice.Text = text
        notice.TextColor3 = kind == "bad" and Theme.bad or (kind == "warn" and Theme.warn or Theme.good)
        notice.Visible = true
        notice.BackgroundTransparency = 0.15
        TweenService:Create(notice, TweenInfo.new(0.15), { BackgroundTransparency = 0.15 }):Play()
        task.delay(2.4, function()
            if token ~= noticeToken then return end
            TweenService:Create(notice, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
            task.delay(0.35, function()
                if token == noticeToken then notice.Visible = false end
            end)
        end)
    end
    GUI.notice = showNotice

    selectTab(GUI.activeTab)

    -- expose for the control builders
    GUI.tabFrames = tabFrames
    GUI.tabButtons = tabButtons

    return {
        screen = screen,
        frame = frame,
        scale = scale,
        tabs = tabFrames,
        selectTab = selectTab,
        showNotice = showNotice,
        setMinimized = setMinimized,
        title = title,
    }
end


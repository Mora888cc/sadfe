local Engine = {}

Engine.humanoid   = nil
Engine.root       = nil
Engine.character  = nil
Engine.vanilla    = nil
Engine.connection = nil
Engine.constraint = nil
Engine.attachment = nil
Engine.dir        = nil
Engine.speed      = 0
Engine.target     = 0
Engine.rampActive = false
Engine.rampStart  = 0
Engine.microLast  = 0
Engine.microBurst = 0
Engine.lastPos    = nil
Engine.rbHits     = 0
Engine.rbWindow   = 0
Engine.reasserts  = 0
